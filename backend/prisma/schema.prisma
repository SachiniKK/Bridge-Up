generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// IMPORTANT — TABLE OWNERSHIP RULES
// ──────────────────────────────────────────────
// Tables owned by backend (Prisma):
//   students, daily_tasks, xp_transactions
//
// Tables owned by nlp-service (SQLAlchemy):
//   job_postings, extracted_skills
//   → NEVER add Prisma models for these tables.
//   → Use prisma.$queryRaw for read access.
//
// See docs/DATABASE_SCHEMA.md for full documentation.
// ──────────────────────────────────────────────

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String
  role          String   @default("student")
  firstName     String
  lastName      String
  age           Int
  city          String
  university    String
  degree        String
  currentYear   String
  aboutMe       String?
  selectedRoles String[]
  createdAt     DateTime @default(now())
}

model Skill {
  id   Int    @id @default(autoincrement())
  name String
}

model Student {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  currentXP      Int       @default(0) @map("current_xp")
  level          Int       @default(1)
  streakCount    Int       @default(0) @map("streak_count")
  lastActiveDate DateTime? @map("last_active_date")
  studyModeUntil DateTime? @map("study_mode_until")
  weeklyHours    Int       @default(5) @map("weekly_hours")
  createdAt      DateTime  @default(now()) @map("created_at")

  dailyTasks     DailyTask[]
  xpTransactions XPTransaction[]

  @@map("students")
}

model DailyTask {
  id          String    @id @default(uuid())
  studentId   String    @map("student_id")
  title       String
  description String?
  skillTag    String?   @map("skill_tag")
  xpValue     Int       @default(10) @map("xp_value")
  taskDate    DateTime  @map("task_date") @db.Date
  status      String    @default("pending")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  student     Student   @relation(fields: [studentId], references: [id])

  @@unique([studentId, taskDate, title])
  @@map("daily_tasks")
}

model XPTransaction {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  amount        Int
  reason        String
  relatedTaskId String?  @map("related_task_id")
  createdAt     DateTime @default(now()) @map("created_at")

  student       Student  @relation(fields: [studentId], references: [id])

  @@map("xp_transactions")
model JobPosting {
  id          Int    @id @default(autoincrement())
  title       String
  company     String
  description String
}