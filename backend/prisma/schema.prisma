generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// IMPORTANT — TABLE OWNERSHIP RULES
// ──────────────────────────────────────────────
// Tables owned by backend (Prisma):
//   students, daily_tasks, xp_transactions, communities, etc.
//
// Tables owned by nlp-service (SQLAlchemy):
//   job_postings, extracted_skills
//   → NEVER add Prisma models for these tables.
//   → Use prisma.$queryRaw for read access.
//
// See docs/DATABASE_SCHEMA.md for full documentation.
// ──────────────────────────────────────────────

model User {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  password             String
  role                 String                @default("student")
  firstName            String
  lastName             String
  age                  Int
  city                 String
  university           String
  degree               String
  currentYear          String
  aboutMe              String?
  selectedRoles        String[]
  companyName          String?
  createdAt            DateTime              @default(now())

  student              Student?
  events               Event[]
  employerSkillSignals EmployerSkillSignal[]
}

model Skill {
  id   Int    @id @default(autoincrement())
  name String
}

model Student {
  id             String    @id @default(uuid())
  userId         Int?      @unique @map("user_id")
  email          String    @unique
  name           String
  currentXP      Int       @default(0) @map("current_xp")
  level          Int       @default(1)
  streakCount    Int       @default(0) @map("streak_count")
  lastActiveDate DateTime? @map("last_active_date")
  studyModeUntil DateTime? @map("study_mode_until")
  weeklyHours    Int       @default(5) @map("weekly_hours")
  createdAt      DateTime  @default(now()) @map("created_at")

  user                  User?                  @relation(fields: [userId], references: [id])
  dailyTasks            DailyTask[]
  xpTransactions        XPTransaction[]
  communityMemberships  CommunityMembership[]
  discussions           Discussion[]
  discussionComments    DiscussionComment[]
  discussionLikes       DiscussionLike[]
  challengeSubmissions  ChallengeSubmission[]
  eventRegistrations    EventRegistration[]
  roadmap               LearningRoadmap?
  quizAttempts          QuizAttempt[]
  verifications         SkillVerification[]
  peerReviews           PeerReview[]
  passport              SkillPassport?
  notifications         Notification[]

  @@map("students")
}

model DailyTask {
  id          String    @id @default(uuid())
  studentId   String    @map("student_id")
  title       String
  description String?
  skillTag    String?   @map("skill_tag")
  xpValue     Int       @default(10) @map("xp_value")
  taskDate    DateTime  @map("task_date") @db.Date
  status      String    @default("pending")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, taskDate, title])
  @@map("daily_tasks")
}

model XPTransaction {
  id              String   @id @default(uuid())
  studentId       String   @map("student_id")
  amount          Int
  reason          String
  relatedTaskId   String?  @map("related_task_id")
  relatedEntityId String?  @map("related_entity_id")
  createdAt       DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])

  @@map("xp_transactions")
}

// ── Communities ──

model Community {
  id          String   @id @default(uuid())
  name        String
  description String?
  skillTag    String   @map("skill_tag")
  memberCount Int      @default(0) @map("member_count")
  createdAt   DateTime @default(now()) @map("created_at")

  memberships CommunityMembership[]
  discussions Discussion[]

  @@map("communities")
}

model CommunityMembership {
  id          String   @id @default(uuid())
  communityId String   @map("community_id")
  studentId   String   @map("student_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([communityId, studentId])
  @@map("community_memberships")
}

model Discussion {
  id           String   @id @default(uuid())
  communityId  String   @map("community_id")
  authorId     String   @map("author_id")
  title        String
  body         String
  likeCount    Int      @default(0) @map("like_count")
  commentCount Int      @default(0) @map("comment_count")
  createdAt    DateTime @default(now()) @map("created_at")

  community Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    Student             @relation(fields: [authorId], references: [id])
  comments  DiscussionComment[]
  likes     DiscussionLike[]

  @@map("discussions")
}

model DiscussionComment {
  id           String   @id @default(uuid())
  discussionId String   @map("discussion_id")
  authorId     String   @map("author_id")
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author     Student    @relation(fields: [authorId], references: [id])

  @@map("discussion_comments")
}

model DiscussionLike {
  id           String   @id @default(uuid())
  discussionId String   @map("discussion_id")
  studentId    String   @map("student_id")
  createdAt    DateTime @default(now()) @map("created_at")

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([discussionId, studentId])
  @@map("discussion_likes")
}

// ── Weekly Challenges ──

model WeeklyChallenge {
  id          String   @id @default(uuid())
  title       String
  description String
  skillTag    String   @map("skill_tag")
  xpReward    Int      @default(50) @map("xp_reward")
  startDate   DateTime @map("start_date") @db.Date
  deadline    DateTime @db.Date
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  submissions ChallengeSubmission[]

  @@map("weekly_challenges")
}

model ChallengeSubmission {
  id           String   @id @default(uuid())
  challengeId  String   @map("challenge_id")
  studentId    String   @map("student_id")
  responseText String?  @map("response_text")
  responseLink String?  @map("response_link")
  status       String   @default("accepted")
  submittedAt  DateTime @default(now()) @map("submitted_at")

  challenge WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  student   Student         @relation(fields: [studentId], references: [id])

  @@unique([challengeId, studentId])
  @@map("challenge_submissions")
}

// ── Events ──

model Event {
  id                String   @id @default(uuid())
  employerId        Int      @map("employer_id")
  title             String
  description       String
  mode              String
  location          String?
  link              String?
  eventDate         DateTime @map("event_date")
  capacity          Int?
  registrationCount Int      @default(0) @map("registration_count")
  skills            String[]
  createdAt         DateTime @default(now()) @map("created_at")

  employer      User                @relation(fields: [employerId], references: [id])
  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  studentId    String   @map("student_id")
  registeredAt DateTime @default(now()) @map("registered_at")

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@map("event_registrations")
}

// ── Personalized Roadmap & Resources ──

model LearningRoadmap {
  id             String        @id @default(uuid())
  studentId      String        @map("student_id") @unique
  targetRole     String        @map("target_role")
  totalWeeks     Int           @default(12) @map("total_weeks")
  potentialXP    Int           @default(1000) @map("potential_xp")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  steps          RoadmapStep[]

  @@map("learning_roadmaps")
}

model RoadmapStep {
  id             String             @id @default(uuid())
  roadmapId      String             @map("roadmap_id")
  skillName      String             @map("skill_name")
  demandPercent  Int                @map("demand_percent")
  durationWeeks  Int                @map("duration_weeks")
  status         String             @default("locked")
  order          Int
  description    String?
  weeksDetails   Json?
  createdAt      DateTime           @default(now()) @map("created_at")

  roadmap        LearningRoadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  resources      RoadmapResource[]

  @@map("roadmap_steps")
}

model RoadmapResource {
  id             String          @id @default(uuid())
  stepId         String          @map("step_id")
  title          String
  type           String
  url            String
  durationMins   Int             @default(30) @map("duration_mins")
  xpReward       Int             @default(50) @map("xp_reward")
  completed      Boolean         @default(false)
  justification  String?
  completedAt    DateTime?       @map("completed_at")

  step           RoadmapStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  quizzes        Quiz[]

  @@map("roadmap_resources")
}

// ── Quizzes ──

model Quiz {
  id             String          @id @default(uuid())
  resourceId     String          @map("resource_id")
  title          String
  questions      Json
  createdAt      DateTime        @default(now()) @map("created_at")

  resource       RoadmapResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  attempts       QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id             String          @id @default(uuid())
  studentId      String          @map("student_id")
  quizId         String          @map("quiz_id")
  score          Int
  passed         Boolean
  submittedAt    DateTime        @default(now()) @map("submitted_at")

  quiz           Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

// ── Peer Review & Claims ──

model SkillVerification {
  id             String          @id @default(uuid())
  studentId      String          @map("student_id")
  skillName      String          @map("skill_name")
  responseText   String?         @map("response_text")
  responseLink   String?         @map("response_link")
  status         String          @default("pending")
  createdAt      DateTime        @default(now()) @map("created_at")

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviews        PeerReview[]

  @@unique([studentId, skillName])
  @@map("skill_verifications")
}

model PeerReview {
  id             String            @id @default(uuid())
  verificationId String            @map("verification_id")
  reviewerId     String            @map("reviewer_id")
  approved       Boolean
  comment        String?
  createdAt      DateTime          @default(now()) @map("created_at")

  verification   SkillVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  reviewer       Student           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([verificationId, reviewerId])
  @@map("peer_reviews")
}

// ── Employer Skill Signals ──

model EmployerSkillSignal {
  id             String                     @id @default(uuid())
  employerId     Int                        @map("employer_id")
  jobRole        String                     @map("job_role")
  industry       String
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  employer       User                       @relation(fields: [employerId], references: [id])
  skills         EmployerSkillRequirement[]

  @@map("employer_skill_signals")
}

model EmployerSkillRequirement {
  id             String                     @id @default(uuid())
  signalId       String                     @map("signal_id")
  skillName      String                     @map("skill_name")
  proficiency    String

  signal         EmployerSkillSignal        @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([signalId, skillName])
  @@map("employer_skill_requirements")
}

// ── Skill Passport & Sharing ──

model SkillPassport {
  id             String           @id @default(uuid())
  studentId      String           @map("student_id") @unique
  isPublic       Boolean          @default(false) @map("is_public")
  shareToken     String           @unique @map("share_token")
  createdAt      DateTime         @default(now()) @map("created_at")

  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courses        PassportCourse[]

  @@map("skill_passports")
}

// Tracks individual completed courses/videos per student on their Skill Passport.
// A row is upserted every time a RoadmapResource is marked completed.
model PassportCourse {
  id          String        @id @default(uuid())
  passportId  String        @map("passport_id")
  resourceId  String        @map("resource_id")
  title       String
  type        String        // "youtube", "coursera", "edx", etc.
  url         String
  skillName   String        @map("skill_name")
  completedAt DateTime      @map("completed_at")

  passport    SkillPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)

  @@unique([passportId, resourceId])
  @@map("passport_courses")
}

// ── Notifications ──

model Notification {
  id             String          @id @default(uuid())
  studentId      String          @map("student_id")
  title          String
  body           String
  type           String
  isRead         Boolean         @default(false) @map("is_read")
  createdAt      DateTime        @default(now()) @map("created_at")

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
