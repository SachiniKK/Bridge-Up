generator client {
  provider="prisma-client-js"
}


datasource db {
  provider="postgresql"
}


model User {

  id Int @id @default(autoincrement())

  email String @unique

  password String

  role String

  createdAt DateTime @default(now())

}


model Skill {

  id Int @id @default(autoincrement())

  name String

}


model JobPosting {

  id Int @id @default(autoincrement())

  title String

  company String

  description String

}